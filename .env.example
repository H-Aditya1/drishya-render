# Solana Devnet only. Owner's public recipient; also the app default.
ADS_SOLANA_RECIPIENT=G5HvwjNTUJQTZa4yEUXPZxUf1a6kAEzpdovGHv5pJqqE
# Optional override: the app already uses the OS temporary directory by default.
# Temporary storage resets on restart/redeploy; an empty value disables checkout.
ADS_DATA_FILE=/tmp/drishya-demo-ads.json
# For retained bookings, use /var/data/drishya-ads.json on a persistent disk.
ADS_PRICE_LAMPORTS=10000
ADS_DURATION_HOURS=24
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
